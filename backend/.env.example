# ---- App ----
APP_ENV=development
APP_DEBUG=true
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
APP_SECRET_KEY=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# ---- Database ----
DATABASE_URL=postgresql+psycopg://animalopolis:animalopolis@localhost:5432/animalopolis

# ---- CORS (comma-separated origins; NEVER use '*' in production) ----
CORS_ORIGINS=http://localhost:5173

# ---- Storage (S3 / R2 / MinIO compatible) ----
# Set STORAGE_BACKEND=s3 for AWS S3, Cloudflare R2, or MinIO.
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=animalopolis-examenes
S3_USE_PATH_STYLE=true
S3_PRESIGNED_EXPIRES_SECONDS=300

# ---- External WhatsApp service API key ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
WHATSAPP_SERVICE_API_KEY=change-me-to-a-long-random-string

# ---- File upload limits ----
MAX_UPLOAD_SIZE_BYTES=15728640
ALLOWED_UPLOAD_MIME=application/pdf,image/jpeg,image/png,image/webp

# ---- Admin bootstrap (created once at startup if no users exist) ----
BOOTSTRAP_ADMIN_EMAIL=admin@animalopolis.app
BOOTSTRAP_ADMIN_PASSWORD=ChangeMeNow!2026
BOOTSTRAP_ADMIN_NOMBRE=Administrador

# ---- Rate limiting ----
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_UPLOAD=30/minute
