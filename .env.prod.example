# Producción — copiar a .env en el servidor y completar. NUNCA commitear el .env real.
#
# Generar secretos:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"   # APP_SECRET_KEY
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"   # WHATSAPP_SERVICE_API_KEY, passwords
#   (o: openssl rand -base64 48)

# ---- Dominio (registro DNS tipo A apuntando a la IP del servidor) ----
DOMAIN=app.tudominio.com
# Email para los certificados Let's Encrypt (avisos de expiración)
ACME_EMAIL=tu-email@ejemplo.com

# ---- Secretos ----
APP_SECRET_KEY=
POSTGRES_PASSWORD=
MINIO_ROOT_USER=animalopolis-s3
MINIO_ROOT_PASSWORD=
WHATSAPP_SERVICE_API_KEY=

# ---- Admin inicial (se crea solo si no existen usuarios) ----
BOOTSTRAP_ADMIN_EMAIL=admin@animalopolis.app
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NOMBRE=Administrador
